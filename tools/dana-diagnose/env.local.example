# Salin menjadi "env.local" di folder ini (JANGAN di-commit).
# Dibaca otomatis oleh diagnose.mjs & run-diagnose.ps1.
# Variabel environment shell selalu menang atas file ini.

# --- Wajib ---
DANA_ENV=sandbox
MERCHANT_ID=216620090026052421673
CLIENT_ID=2026092618040865582354

# Cara paling aman: taruh kunci PKCS#8 di file terpisah, lalu isi path-nya.
# Path relatif dihitung dari direktori kerja PowerShell Anda.
DANA_PRIVATE_KEY_PATH=./secrets/dana-private-key.pem

# Alternatif bila ingin menempel langsung (base64 PKCS#8 tanpa header juga diterima):
# DANA_PRIVATE_KEY=MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...

# --- Penting untuk uji hipotesis H4 (ORIGIN) ---
# Harus sama dengan domain/origin aplikasi yang Anda daftarkan di dashboard DANA.
DANA_ORIGIN=https://customlink.pages.dev

# --- Kunci jawaban DIVISION_NOT_EXIST (hipotesis H3) ---
# External Division ID dari dashboard.dana.id/sandbox/submerchants -> tab "Division".
DANA_DIVISION_ID=d5831d89

# --- Opsional ---
# Isi HANYA bila memang memakai skema Division. Kosongkan untuk mereproduksi bug lama
# (worker mengirim External Shop ID sebagai subMerchantId -> 4045408 DIVISION_NOT_EXIST).
SUB_MERCHANT_ID=d5831d89
# External Shop ID (tab "Shop") -> dikirim sebagai externalStoreId, hanya bila diisi.
EXTERNAL_STORE_ID=
# Wajib 1-5 karakter (spec DANA). Nilai pada Sample Payload dashboard = 95221.
DANA_CHANNEL_ID=95221
DANA_MCC=5734
